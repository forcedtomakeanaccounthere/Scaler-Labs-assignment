# Backend API URL (required in production)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Frontend app URL (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Product name (optional)
NEXT_PUBLIC_PRODUCT_NAME=RedactIQ

# Google OAuth (optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# reCAPTCHA (optional — test key used if unset)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ── Production (Vercel) ──────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app  # optional on Vercel (auto-detected)
