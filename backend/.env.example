# Server
PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Database (use localhost for local dev, service names for Docker Compose)
MONGODB_URI=mongodb://127.0.0.1:27017/redactiq
REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=change_me_in_production

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# reCAPTCHA
RECAPTCHA_SECRET_KEY=

# File upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50
RETENTION_HOURS=24

# Python PII microservice (optional — regex fallback works without it)
PYTHON_SERVICE_URL=http://localhost:8000

# ── Production (Render) example ──────────────────────────────────────────
# BACKEND_URL=https://your-api.onrender.com
# FRONTEND_URL=https://your-app.vercel.app
# MONGODB_URI=mongodb+srv://...
# REDIS_URL=redis://...
